<%- include('partials/header') %>

<section class="section">
  <h1 class="page-title">Session Log</h1>
  <p class="page-sub">Record time you spent on each platform.</p>

  <div class="card">
    <h2 class="card-title">Log a Session</h2>
    <form action="/log" method="POST" class="form">
      <div class="form-group">
        <label for="platform">Platform</label>
        <select id="platform" name="platform" required>
          <% if (goals.length > 0) { %>
            <% goals.forEach(g => { %>
              <option value="<%= g.platform %>"><%= g.platform %></option>
            <% }) %>
          <% } else { %>
            <option value="">No goals set — add goals first</option>
          <% } %>
        </select>
      </div>
      <div class="form-group">
        <label for="minutes">Duration (minutes)</label>
        <input type="number" id="minutes" name="minutes" min="1" max="480" placeholder="15" required />
      </div>
      <div class="form-group">
        <label for="date">Date</label>
        <input type="date" id="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required />
      </div>
      <button type="submit" class="btn btn-primary">Log Session</button>
    </form>
  </div>

  <h2 class="section-title" style="margin-top: 2rem;">Past Sessions</h2>
  <% if (sessions.length === 0) { %>
    <div class="empty-state"><p>No sessions logged yet.</p></div>
  <% } else { %>
    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Platform</th>
            <th>Duration</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% sessions.forEach(s => { %>
            <tr>
              <td><%= s.date %></td>
              <td><%= s.platform %></td>
              <td><%= s.minutes %> min</td>
              <td>
                <form action="/log/<%= s.id %>?_method=DELETE" method="POST">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
