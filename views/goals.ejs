<%- include('partials/header') %>

<section class="section">
  <h1 class="page-title">My Goals</h1>
  <p class="page-sub">Set daily time limits for each platform.</p>

  <div class="card">
    <h2 class="card-title">Add New Goal</h2>
    <form action="/goals" method="POST" class="form">
      <div class="form-group">
        <label for="platform">Platform</label>
        <input type="text" id="platform" name="platform" placeholder="e.g. Instagram" required />
      </div>
      <div class="form-group">
        <label for="limitMinutes">Daily Limit (minutes)</label>
        <input type="number" id="limitMinutes" name="limitMinutes" min="1" max="480" placeholder="30" required />
      </div>
      <div class="form-group">
        <label for="color">Color</label>
        <input type="color" id="color" name="color" value="#6366f1" />
      </div>
      <button type="submit" class="btn btn-primary">Add Goal</button>
    </form>
  </div>

  <h2 class="section-title" style="margin-top: 2rem;">Current Goals</h2>
  <% if (goals.length === 0) { %>
    <div class="empty-state"><p>No goals yet. Add one above!</p></div>
  <% } else { %>
    <div class="goal-list">
      <% goals.forEach(g => { %>
        <div class="goal-card">
          <div class="goal-header">
            <span class="platform-badge" style="background-color: <%= g.color %>"><%= g.platform %></span>
            <span class="goal-time">Limit: <%= g.limitMinutes %> min/day</span>
          </div>
          <form action="/goals/<%= g.id %>?_method=DELETE" method="POST" style="margin-top: 0.5rem;">
            <button type="submit" class="btn btn-danger btn-sm">Remove</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
